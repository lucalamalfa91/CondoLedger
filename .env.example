# Copia questo file in `.env` e adatta i valori.
# Il file `.env` è in .gitignore: non va mai committato.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Due modalità, scelte automaticamente.
#
# 1) Turso (produzione): imposta queste due e all'app non serve alcun disco
#    persistente, quindi può stare su qualunque host gratuito.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
#
# 2) File locale (sviluppo e test): usato quando TURSO_DATABASE_URL è vuota.
DB_PATH=./data/condoledger.db

# true quando il sito è servito in HTTPS (produzione). In locale su http:// va false,
# altrimenti il browser rifiuta il cookie di sessione.
COOKIE_SECURE=false

# Durata della sessione in giorni.
SESSION_TTL_DAYS=30

# --- Solo per la migrazione una-tantum dei dati da Supabase ---
# Si rimuovono subito dopo il cutover.
#
# Su un host dove non puoi aprire una shell (Railway, Render...), imposta tutte e tre
# queste variabili nel pannello: al primo avvio il server migra da solo e scrive il
# diario nei log. Non parte se il database contiene già delle case.
MIGRATE_FROM_SUPABASE=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Primo accesso, sempre dal pannello dell'host ---
# Crea l'utente se non esiste, o ne reimposta la password se esiste già (è il caso
# dopo la migrazione: gli hash di Supabase non sono riutilizzabili).
# Si rimuovono subito dopo il primo accesso. La password non finisce mai nei log.
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
