# Copia questo file in `.env` e adatta i valori.
# Il file `.env` è in .gitignore: non va mai committato.

# --- Server ---
PORT=3000
NODE_ENV=development

# Percorso del file SQLite. In produzione punta a un volume persistente
# (es. /data/condoledger.db su Fly.io).
DB_PATH=./data/condoledger.db

# true quando il sito è servito in HTTPS (produzione). In locale su http:// va false,
# altrimenti il browser rifiuta il cookie di sessione.
COOKIE_SECURE=false

# Durata della sessione in giorni.
SESSION_TTL_DAYS=30

# --- Solo per la migrazione una-tantum dei dati (scripts/migrate-supabase-to-sqlite.mjs) ---
# Si cancellano dopo il cutover.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
